# ─── Dor queue system — environment ───────────────────────────────────────────
# Copy to .env and adjust. Never commit real secrets.

# Public URL of this server as seen from browsers on the office LAN (used in QR codes, invite links, and the
# CSRF origin check: it must be the address people type, including https:// when behind a TLS proxy).
APP_URL=http://localhost:3000
PORT=3000
# Docker: address the app port is published on. 0.0.0.0 = whole LAN; 127.0.0.1 = only a reverse proxy on this machine.
APP_BIND=0.0.0.0

# PostgreSQL 15+ connection string. Docker Compose builds it from the POSTGRES_* values below.
DATABASE_URL=postgres://dor:dor@localhost:5432/dor
DATABASE_POOL_MAX=20
# Docker Compose only (db container). PRODUCTION: set a strong POSTGRES_PASSWORD (openssl rand -hex 24).
POSTGRES_USER=dor
POSTGRES_PASSWORD=dor
POSTGRES_DB=dor
# Separate database used by integration tests (created by the tests if missing).
TEST_DATABASE_URL=postgres://dor:dor@localhost:5432/dor_test

# 32 random bytes, base64. Encrypts 2FA secrets at rest. Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Random string (>= 16 chars). Keys the visitor phone hash. Generate: openssl rand -hex 24
PHONE_HASH_KEY=

# Optional: enables Redis for multi-node realtime + rate limiting. Leave empty for single-server installs.
REDIS_URL=

SESSION_TTL_HOURS=12
# Set to true only when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Number of reverse proxies in front of the app (the client address is that many entries from the right of X-Forwarded-For).
TRUST_PROXY_HOPS=1
# auto = Secure cookies when APP_URL is https.
COOKIE_SECURE=auto
LOG_LEVEL=info
# Docker: container log rotation and graceful-shutdown time (seconds).
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5
SHUTDOWN_TIMEOUT_SECONDS=20

# Outgoing email (invites, scheduled reports). If unset, invite links can be copied from the admin UI.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Dor Queue <no-reply@example.com>"
SMTP_SECURE=false

# Announcement voice "Natural sentence voice (online)": the server renders each spoken sentence once (needs internet the
# first time) and caches it here. Default: a "dor-tts" folder in the system temp directory. In Docker, point it at a volume.
# TTS_CACHE_DIR=/var/cache/dor-tts

# Visitor messages (Admin -> Notifications). WhatsApp Cloud API (Meta):
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_API_URL=https://graph.facebook.com
# SMS: "twilio" (needs TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, SMS_FROM) or "http" (any gateway).
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMS_FROM=
# Generic gateway: the URL and the body may contain {to} {text} {from}.
SMS_URL=
SMS_METHOD=POST
SMS_AUTH_HEADER=
SMS_BODY_FORMAT=json
SMS_BODY='{"to":"{to}","from":"{from}","text":"{text}"}'
SMS_MESSAGE_ID_PATH=

# Development/demo: record outgoing email/WhatsApp/SMS in memory instead of sending (see server logs).
MESSAGING_MOCK=false
# Seconds before a provider request (WhatsApp/SMS) is abandoned.
MESSAGING_TIMEOUT_SECONDS=15

# ─── First start ─────────────────────────────────────────────────────────────
# Production (no demo data): the container creates this super admin on start if it does not exist (the password
# is never changed afterwards; `npm run admin:create -- --reset-password` replaces it). Min. 10 chars, upper+lower+digit.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME_AR=
ADMIN_NAME_EN=
ORG_NAME_AR=
ORG_NAME_EN=

# ─── Backups (docs/backup-restore.md) ───────────────────────────────────────
# db-backup.mjs / backup.ps1 read this file; backup.sh reads the process environment (crontab line or systemd unit).
# BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=14
# BACKUP_KEEP_WEEKLY=8
# BACKUP_VERIFY_RESTORE=1
# BACKUP_ENCRYPT=none            # none | openssl | age (backup.sh); db-backup.mjs encrypts when BACKUP_PASSPHRASE is set
# BACKUP_PASSPHRASE=
# BACKUP_UPLOAD_CMD='rclone copy "$BACKUP_FILE" remote:dor-backups/'
# Admin -> Overview shows the backup as overdue after this many hours:
# BACKUP_MAX_AGE_HOURS=36

# Demo data: create the Arabic demo organization on first start (docker) and its demo password.
# Trial installs: true. Production: false (the production compose file forces false) and use ADMIN_EMAIL above.
SEED_DEMO=true
SEED_PASSWORD=Dor@Demo2026
