{
  "name": "dor-queue",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --clear-screen=false --exclude \"./src/**\" --exclude \"./messages/**\" --exclude \"./.next/**\" --exclude \"./.local/**\" server.ts",
    "build": "next build",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed/index.ts",
    "db:reset": "tsx src/db/seed/index.ts --reset",
    "local": "tsx scripts/local.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "@node-rs/argon2": "^2.2.1",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@oslojs/otp": "^1.1.0",
    "@tanstack/react-query": "^5.104.0",
    "adhan": "^4.4.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "echarts": "^6.1.0",
    "lucide-react": "^1.48.0",
    "next": "15.5.26",
    "next-intl": "^4.14.7",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.12",
    "pg": "^8.23.0",
    "pg-boss": "^12.35.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
