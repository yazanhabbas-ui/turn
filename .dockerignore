# Keep the build context small and free of secrets. The Dockerfile copies explicit paths; this is the safety net.
.git
.github
.gitattributes
.gitignore
node_modules
.next
.next-*
.local
.env
.env.*
!.env.example
backups
coverage
playwright-report
test-results
tests
docs
!docs/manuals/pdf
assets
voice-samples
scripts
*.log
*.tsbuildinfo
.vscode
.idea
.DS_Store
Dockerfile
docker-compose*.yml
README.md
